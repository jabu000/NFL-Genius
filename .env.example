# DraftKings player props via The Odds API (https://the-odds-api.com). Optional.
ODDS_API_KEY=
# Hours before cached prop lines are re-fetched (free tier = 500 credits/month).
ODDS_MAX_AGE_HOURS=24
# Comma-separated Odds API markets (default: pass yds/tds, rush yds, rec yds, receptions, anytime TD).
ODDS_MARKETS=
# Stop fetching props when this many credits remain.
ODDS_CREDIT_RESERVE=10

# Free LLM providers for daily write-ups. Optional; falls back to templates.
# gemini | groq | template
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Pause between LLM batches (ms) to stay inside free-tier rate limits.
LLM_DELAY_MS=6500

# NFL season to research (defaults to current season by date).
NFL_SEASON=
